# Direct control that bypasses the language model. A pause supersedes a pending request.
# defer and retry are recovery decisions: give up on parcels for now, or take deferred parcels up again.

string COMMAND_PAUSE=pause
string COMMAND_RESUME=resume
string COMMAND_STATUS=status
string COMMAND_DEFER=defer
string COMMAND_RETRY=retry

string command
string[] parcels               # For defer and retry; empty otherwise
string reason                  # Recorded with a deferral
---
bool accepted
string request_id              # e.g. D2
string message
